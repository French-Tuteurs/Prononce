rules_version = '2';

// ===========================
// PRONONCE — FIRESTORE SECURITY RULES
// ===========================
//
// One document per signed-in user at users/{uid}, holding:
//   - email            (string)
//   - isOwner          (bool)  — the single admin account. NEVER
//                                settable from the app; set by hand
//                                once, in the Firebase console, for
//                                exactly one account.
//   - isTester         (bool)  — grants access to the voice
//                                recording page. Only an isOwner
//                                account can change this, and only
//                                on OTHER users' documents.
//   - progress         (map)   — { lessonId: true, ... }
//   - consent          (map or null) — voice-recording consent,
//                                recorded once per account.
//   - disabled         (bool)  — an owner-only ban flag. Same
//                                protection as isOwner/isTester: a
//                                user can never flip this on their
//                                own document.
//   - createdAt        (string, ISO date) — set once at signup.
//   - motto, avatarEmoji, accentColor (strings) — purely cosmetic
//                                self-service personalization, no
//                                different from email/name.
//
// The core guarantee: a signed-in user can freely read and update
// their OWN document (progress, consent, email) but can never touch
// isOwner or isTester on it. Only a document already flagged
// isOwner may write isOwner/isTester on ANY document — including
// listing/querying the whole users collection, needed so the owner
// can look someone up by email or list current testers.
//
// Four more top-level collections — see each match block below for
// details:
//   - recordingPages/{pageId}  — owner-authored prompt sets
//   - siteConfig/{docId}       — small owner-controlled settings
//                                (siteConfig/recording.activePageId)
//   - recordings/{recordingId} — one doc per submitted audio take
//   - mail/{mailId}            — outgoing email queue for the
//                                Firebase "Trigger Email" extension

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true;
    }

    match /users/{userId} {

      allow get: if isSignedIn() && (request.auth.uid == userId || isOwnerAccount());

      allow list: if isOwnerAccount();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isOwner == false
        && request.resource.data.isTester == false;

      // A user may update their own document as long as isOwner,
      // isTester, and disabled (an owner-only ban flag) come out
      // unchanged. get(key, default) tolerates older documents that
      // predate the disabled field.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isOwner == resource.data.isOwner
        && request.resource.data.isTester == resource.data.isTester
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false);

      // The owner may update any document (this is how tester
      // access is granted/revoked).
      allow update: if isOwnerAccount();

      // A non-owner account may delete its own document (this is
      // what powers the self-service "delete my account" button —
      // the owner account is excluded so there's always someone left
      // who can run the admin tools).
      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && resource.data.isOwner != true;

    }


    // recordingPages/{pageId} — the owner-authored word/sentence lists
    // the voice-recording page (collect.html) prompts testers with.
    // Several can exist at once (rotated every few weeks); which one
    // is live is resolved per-visitor from siteConfig/recording and
    // users/{uid}.recordingPageId — see collect.js. Content only, no
    // access control of its own, so any signed-in user can read it;
    // only the owner authors it.
    match /recordingPages/{pageId} {

      allow get, list: if isSignedIn();
      allow create, update, delete: if isOwnerAccount();

    }


    // siteConfig/{docId} — small owner-controlled site settings, e.g.
    // siteConfig/recording.activePageId (the sitewide-default recording
    // page). Readable by anyone signed in so every page can resolve it;
    // only the owner can change it.
    match /siteConfig/{docId} {

      allow get: if isSignedIn();
      allow create, update, delete: if isOwnerAccount();

    }


    // recordings/{recordingId} — one document per submitted audio take
    // (see collect.js), pointing at the actual file in Storage. A
    // tester can only create entries under their own uid and can never
    // edit or remove one once submitted (that would let someone erase
    // evidence of a bad take); only the owner can browse, update
    // (e.g. marking one reviewed) or delete them.
    match /recordings/{recordingId} {

      allow get: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isOwnerAccount());

      allow list: if isOwnerAccount();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isOwnerAccount();

    }


    // mail/{mailId} — the outgoing-email queue the Firebase "Trigger
    // Email" extension watches (see admin-email.js). The owner can
    // queue new messages; nothing reads, edits, or deletes a queued
    // message from the client afterward — the extension's own Cloud
    // Function processes these with admin privileges, which bypass
    // these rules entirely, so this only ever needs to cover the
    // owner's initial write.
    match /mail/{mailId} {

      allow create: if isOwnerAccount();
      allow get, list, update, delete: if false;

    }

  }
}
